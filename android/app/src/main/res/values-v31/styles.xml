<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: neon canvas + the hamster launcher icon. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/tauntbuddy_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:statusBarColor">@color/tauntbuddy_background</item>
        <item name="android:navigationBarColor">@color/tauntbuddy_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:statusBarColor">@color/tauntbuddy_background</item>
        <item name="android:navigationBarColor">@color/tauntbuddy_background</item>
    </style>
</resources>
